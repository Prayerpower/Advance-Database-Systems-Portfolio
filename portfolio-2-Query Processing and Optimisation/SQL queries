-- =============
-- SQL QUERIES
-- =============
-- Query 1: View all Dove Bank customers
SELECT * FROM customers;

-- Query 2: View all accounts
SELECT * FROM accounts;

-- Query 3: View all transactions
SELECT * FROM transactions;

-- Query 4: View customers with their accounts
SELECT
    customers.first_name,
    customers.last_name,
    accounts.account_number,
    accounts.account_type,
    accounts.balance
FROM customers
JOIN accounts
ON customers.customer_id = accounts.customer_id;

-- Query 5: View transactions for Account 1 (James John)
SELECT *
FROM transactions
WHERE account_id = 1;

-- =============
-- EXECUTION PLAN BEFORE INDEXING
-- =============
EXPLAIN ANALYZE
SELECT *
FROM transactions
WHERE account_id = 1;

-- =============
-- CREATE INDEX FOR OPTIMISATION
-- =============
CREATE INDEX idx_transactions_account
ON transactions(account_id);

-- =============
-- EXECUTION PLAN AFTER INDEXING
-- =============
EXPLAIN ANALYZE
SELECT *
FROM transactions
WHERE account_id = 1;
